{
  "manifest_version": 1,
  "id": "mask-emails",
  "name": "隐藏邮箱",
  "version": "1.0.0",
  "description": "发出之前，把 messages 里每段文本中的邮箱换成 <email>。",
  "author": "example",
  "kind": "rules",
  "hooks": ["request"],
  "priority": 100,
  "enabled_by_default": false,
  "rules": [
    {
      "op": "mask",
      "path": "messages.*.content",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replacement": "<email>"
    }
  ]
}
